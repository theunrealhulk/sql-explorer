{
  "name": "sql-explorer",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "tsc && npm run build:editor",
    "start": "node dist/server.js",
    "dev": "nodemon",
    "build:css": "tailwindcss -i ./src/input.css -o ./views/output.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./views/output.css --watch",
    "build:editor": "esbuild src/editor/codemirror-entry.js --bundle --format=iife --minify --outfile=views/vendor/codemirror/codemirror.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/theme-one-dark": "^6.1.3",
    "better-sqlite3": "^13.0.3",
    "codemirror": "^6.0.2",
    "d3": "^7.9.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsoneditor": "^10.4.3",
    "lucide": "^1.28.0",
    "mssql": "^12.7.0",
    "multer": "^2.2.0",
    "node-sql-parser": "^5.4.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/mssql": "^12.3.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.2",
    "daisyui": "^5.7.16",
    "esbuild": "^0.28.1",
    "nodemon": "^3.1.14",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "@parcel/watcher@2.5.1": true
  }
